#!/bin/sh
# durchlauferhitzer-reload: restart a running server without losing a
# connection (FR-PROC-07, the HAProxy model). POSIX sh (dash, busybox ash).
#
# usage: durchlauferhitzer-reload <binary> <config> <pidfile> <logfile>
#        [ready-timeout-seconds [grace-seconds]]
#
#  0. Take the lock <pidfile>.lock (a directory; the file pid in it,
#     created exclusively, holds the helper's pid and start time): one
#     reload at a time. A lock whose pid no longer runs with that start
#     time is stale: it is taken over, with a note on stderr, under a
#     guard (<pidfile>.lock/takeover), so that of helpers finding it at
#     once one at most proceeds.
#  1. <binary> --check <config>; on an error, print it and stop.
#  2. net.ipv4.tcp_migrate_req must be 1 (written if 0, never restored):
#     the old process's queued connections then move to the new one.
#  3. The pid in <pidfile> must run <binary> (" (deleted)" allowed: the
#     binary may be replaced in place, not re-pointed by a symlink).
#  4. Start "<binary> --ready-fd 3 <config>" in its own session, output
#     appended to <logfile>, fd 3 a FIFO in a fresh private directory,
#     fds 4-9 closed. Its pid and start time go to <pidfile>.draining at
#     once, so the OpenRC script's stop ends it should this helper be
#     killed before the handover, also while that pid is still this
#     helper's fork on its way to <binary>. The fork runs <binary> only
#     once it is listed (if the list cannot be written, stop here); a
#     helper killed before that leaves nothing running (the fork exits).
#  5. Wait for "ready" (at least the timeout, default 30 s, measured on
#     the clock). Otherwise stop the new process (below) and leave the old
#     one untouched. Once ready, the new process steers every new
#     connection to itself.
#  6. Signals ignored from here: add the old pid and its start time to
#     <pidfile>.draining (the OpenRC script's stop ends those still
#     running; if the list cannot be written, stop here), point <pidfile>
#     at the new process (temp file, then rename), drop the new one from
#     the list, wait the grace (default 1 s: handshakes under way on the
#     old listeners finish). Then the new process must still run
#     <binary>: if it died during the grace, the old pid goes back into
#     <pidfile>, off the list, and the helper exits 1 (the old process
#     serves on; if it is gone too, nothing serves). Otherwise send the
#     old process SIGHUP: it closes its listeners and drains. A new
#     process gone right after it is exit 1 too.
#  7. Wait (at least 10 s) until the old process holds no listening socket
#     (its /proc/<pid>/fd sockets against the LISTEN rows of
#     /proc/net/tcp and tcp6), so the next reload finds two processes per
#     port; only then release the lock. Past 10 s, warn and release.
#
# A new process that is not handed over (not ready in time, the pid file
# not written, the helper interrupted before step 6) gets SIGHUP, not
# SIGTERM: one that is still starting up ends at once (the signal's
# default action), one that is already serving closes its listeners (the
# old process still listens, so their queues move to it) and drains what
# it holds. The helper waits for it 10 s. One that still has the SIGHUP
# pending then never read it: it is stuck before its event loop (past
# its signal mask), so it has accepted no connection, and it gets
# SIGKILL (its listeners' queues move to the old process). Any other is
# left running, listed in <pidfile>.draining for the OpenRC script's
# stop, with a warning: one still draining, or one that ignores SIGHUP
# because the helper itself was started with it ignored (`nohup`), which
# the new process inherits and the shell cannot undo. Do not run the
# helper under `nohup`.
#
# Exit 0 on success (a step 7 timeout included: the handover is done); 1
# with a one-line reason on stderr otherwise.

# shellcheck disable=SC2317 # cleanup and its helpers run from a trap

me=durchlauferhitzer-reload
migrate=/proc/sys/net/ipv4/tcp_migrate_req

fail() {
	printf '%s: %s\n' "$me" "$*" >&2
	exit 1
}

warn() {
	printf '%s: warning: %s\n' "$me" "$*" >&2
}

usage() {
	fail "usage: $me <binary> <config> <pidfile> <logfile> [ready-timeout-seconds [grace-seconds]]"
}

case $# in
4 | 5 | 6) ;;
*) usage ;;
esac
binary=$1 config=$2 pidfile=$3 logfile=$4 timeout=${5:-30} grace=${6:-1}
case $timeout in
'' | *[!0-9]* | 0*) usage ;;
esac
case $grace in
'' | *[!0-9]* | 0?*) usage ;;
esac
# How long step 7, and the stop of a new process not handed over, wait,
# in seconds.
close_timeout=10

# The state of a pid ("R", "S", "Z", ...), empty if there is none.
state() {
	sed -n 's/^.*) \(.\).*$/\1/p' "/proc/$1/stat" 2>/dev/null
}

running() {
	s=$(state "$1")
	[ -n "$s" ] && [ "$s" != Z ]
}

# The start time of a pid (field 22 of its stat, counted after the last
# ")": the command name may hold spaces and parentheses).
start_time() {
	sed -n 's/^.*) //p' "/proc/$1/stat" 2>/dev/null | cut -d ' ' -f 20
}

# The executable a pid runs, without the " (deleted)" of a replaced file.
exe_of() {
	e=$(readlink "/proc/$1/exe" 2>/dev/null) || return 1
	printf '%s\n' "${e% (deleted)}"
}

# Whether pid $1 holds a listening TCP socket: 0 yes, 1 no, 2 its
# descriptors cannot be read. One `ls` for all its descriptors, since a
# draining process may hold many; its exit status is not used (a
# descriptor closing while it lists is an error there), only what it
# printed: a running server always has descriptors, so nothing printed
# means none could be read.
holds_listener() {
	fds=$(ls -l "/proc/$1/fd" 2>/dev/null)
	[ -n "$fds" ] || return 2
	tables=
	for t in /proc/net/tcp /proc/net/tcp6; do
		[ -r "$t" ] && tables="$tables $t"
	done
	# shellcheck disable=SC2086 # one argument per table
	printf '%s\n' "$fds" | sed -n 's/.*-> socket:\[\([0-9]*\)\]$/\1/p' |
		awk 'FILENAME == "-" { held[$1] = 1; next }
			$4 == "0A" && ($10 in held) { found = 1 }
			END { exit !found }' - $tables
}

# Whether pid $1 has SIGHUP (signal 1, the lowest bit of ShdPnd, in
# hex) pending: sent, not yet read.
hup_pending() {
	hp=$(sed -n 's/^ShdPnd:[[:space:]]*//p' "/proc/$1/status" 2>/dev/null)
	case $hp in
	*[13579bdfBDF]) return 0 ;;
	esac
	return 1
}

# Whether pid $1 runs with start time $2 (any start time when $2 is
# empty).
runs_as() {
	running "$1" && { [ -z "$2" ] || [ "$(start_time "$1")" = "$2" ]; }
}

# Seconds since the epoch.
now() {
	date +%s
}

# Whether more than $2 whole seconds have passed since $1 (from `now`):
# then at least $2 seconds have.
past() {
	[ $(($(now) - $1)) -gt "$2" ]
}

lock=$pidfile.lock locked='' guarded='' dir='' new='' reader='' handed_over=''
draining=$pidfile.draining

# Rewrites the draining list ("<pid> <start time>" lines): the entries
# that still run with their start time, but $1 (a pid, or empty), then
# $2 (a pid, or empty) with its own start time. Temp file, then rename;
# a failure leaves the list as it was. A pid and its start time name one
# process (a reused pid has another start time); a listed one runs
# <binary>, or is still a helper's fork on its way to it (step 4), which
# the OpenRC script's stop must end as well.
list_draining() {
	ld_tmp=$(mktemp "$draining.XXXXXX") || return 1
	if {
		if [ -f "$draining" ]; then
			while read -r pid start; do
				case $pid in
				'' | *[!0-9]* | "$1" | "$2") continue ;;
				esac
				[ -n "$start" ] && runs_as "$pid" "$start" &&
					printf '%s %s\n' "$pid" "$start"
			done <"$draining"
		fi
		if [ -n "$2" ]; then
			printf '%s %s\n' "$2" "$(start_time "$2")"
		fi
	} >"$ld_tmp" && mv -f "$ld_tmp" "$draining"; then
		return 0
	fi
	rm -f "$ld_tmp"
	return 1
}

# Points <pidfile> at pid $1 (temp file, then rename).
write_pidfile() {
	wp_tmp=$(mktemp "$pidfile.XXXXXX") || return 1
	if printf '%s\n' "$1" >"$wp_tmp" && chmod 644 "$wp_tmp" && mv -f "$wp_tmp" "$pidfile"; then
		return 0
	fi
	rm -f "$wp_tmp"
	return 1
}

# Stops a new process that was not handed over: SIGHUP (see the header),
# then up to $close_timeout s for it to end; it is reaped and dropped
# from the draining list, or, still draining, left on it with a warning.
stop_new() {
	kill -HUP "$new" 2>/dev/null
	t0=$(now)
	while running "$new" && ! past "$t0" "$close_timeout"; do
		sleep 1
	done
	if running "$new" && hup_pending "$new"; then
		kill -KILL "$new" 2>/dev/null
		sleep 1
	fi
	if running "$new"; then
		warn "the new process (pid $new) still runs after $close_timeout s (draining, or SIGHUP ignored); left running, listed in $draining"
		return
	fi
	wait "$new" 2>/dev/null
	list_draining "$new" ''
}

cleanup() {
	trap '' HUP INT TERM
	[ -n "$reader" ] && kill "$reader" 2>/dev/null
	[ -n "$new" ] && [ -z "$handed_over" ] && stop_new
	[ -n "$dir" ] && rm -rf "$dir"
	[ -n "$guarded" ] && rm -f "$lock/takeover"
	# The directory goes with the pid file unless another helper's guard
	# is in it.
	[ -n "$locked" ] && rm -f "$lock/pid" && rmdir "$lock" 2>/dev/null
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

# 0. One reload at a time. The lock is the file <pidfile>.lock/pid,
# created by this shell itself with noclobber (O_EXCL: one creator wins),
# so it does not rest on mkdir failing for an existing directory (uutils
# coreutils' mkdir does not reliably when two run at once). A stale lock
# (its holder not running with its start time) is taken over under the
# guard <pidfile>.lock/takeover, made the same way: its maker reads the
# holder again (the same stale one, else it refuses), removes the pid
# file and creates its own (a helper that took the lock in between
# wins). So no helper removes a lock another holds, and of helpers
# finding a stale lock at once one at most proceeds.
own_start=$(start_time $$)

# Creates $1 holding this shell's pid and start time, if it does not
# exist: 0 created, 1 not.
create_excl() {
	(
		set -C
		printf '%s %s\n' $$ "$own_start" >"$1"
	) 2>/dev/null
}

# Takes the free lock: 0 taken, 1 not (held, or the directory cannot be
# made). The directory may have just gone with its last holder: then it
# is made again once.
take_lock() {
	err=$(mkdir "$lock" 2>&1)
	[ -d "$lock" ] || fail "cannot create the lock $lock: ${err#mkdir: }"
	create_excl "$lock/pid" && return 0
	[ -e "$lock/pid" ] && return 1
	mkdir "$lock" 2>/dev/null
	create_excl "$lock/pid"
}

if ! take_lock; then
	holder='' holder_start=''
	{ read -r holder holder_start <"$lock/pid"; } 2>/dev/null
	case $holder in
	'' | *[!0-9]*)
		fail "another reload is running (pid unknown; remove $lock if none is)"
		;;
	esac
	runs_as "$holder" "$holder_start" &&
		fail "another reload is running (pid $holder; remove $lock if none is)"
	create_excl "$lock/takeover" ||
		fail "another reload is running (it is taking over the stale lock $lock; remove $lock if none is)"
	guarded=yes
	again='' again_start=''
	{ read -r again again_start <"$lock/pid"; } 2>/dev/null
	[ "$again $again_start" = "$holder $holder_start" ] ||
		fail "another reload is running (it took over the stale lock $lock)"
	printf '%s: taking over the stale lock %s (pid %s is not running)\n' "$me" "$lock" "$holder" >&2
	rm -f "$lock/pid"
	create_excl "$lock/pid" || fail "another reload took the lock $lock first"
	rm -f "$lock/takeover"
	guarded=''
fi
locked=yes

# 1. The config.
if ! out=$("$binary" --check "$config" 2>&1); then
	[ -n "$out" ] && printf '%s\n' "$out" >&2
	fail "the config check failed: $config"
fi

# 2. Queued connections must move to the new process.
[ -e "$migrate" ] || fail "$migrate is missing (Linux 5.14 or later is needed)"
if [ "$(cat "$migrate" 2>/dev/null)" != 1 ]; then
	{ echo 1 >"$migrate"; } 2>/dev/null
	[ "$(cat "$migrate" 2>/dev/null)" = 1 ] || fail "cannot set $migrate to 1"
fi

# 3. The old process.
real=$(readlink -f "$binary") || fail "no binary: $binary"
old=
{ read -r old <"$pidfile"; } 2>/dev/null
case $old in
'' | *[!0-9]*) fail "no pid in $pidfile" ;;
esac
[ "$(exe_of "$old")" = "$real" ] || fail "pid $old (from $pidfile) is not running $real"

# 4. The new process, with fd 3 the write end of the FIFO "ready" and
# none of this shell's other descriptors below 10 (POSIX can name no
# higher ones). Its pid is this shell's fork, which runs setsid, which
# runs the binary: listed at once, it is on its way to the binary, which
# the OpenRC script's stop allows for (it matches pid and start time).
# The fork waits on a second FIFO, "go", written once it is listed, so
# the binary never runs unlisted: a list that cannot be written stops
# the helper (exit 1) before "go". Every FIFO end is opened here before the fork (an end opened
# read-write first lets the others open at once), so no process ever
# blocks in an open: the fork gets the write end of "ready" (fd 4, its
# fd 3) and the read end of "go" (fd 6); this shell keeps the read end
# of "ready" (fd 5, for the reader) and the only write end of "go" (fd
# 7). A helper that stops or is killed before "go" leaves the fork the
# end of file: it exits, the binary never started.
{ printf '' >>"$logfile"; } 2>/dev/null || fail "cannot append to $logfile"
dir=$(mktemp -d) || fail "mktemp -d failed"
fifo=$dir/ready go=$dir/go
mkfifo -m 600 "$fifo" "$go" || fail "mkfifo failed"
exec 8<>"$fifo"
# shellcheck disable=SC2094 # the two ends of one FIFO
exec 5<"$fifo" 4>"$fifo" 8>&-
exec 7<>"$go"
exec 6<"$go"
(
	trap - EXIT
	exec 5<&- 7>&-
	IFS= read -r go_line <&6 && [ "$go_line" = go ] || exit 1
	exec setsid "$binary" --ready-fd 3 "$config" </dev/null >>"$logfile" 2>&1 3>&4 \
		4>&- 5>&- 6>&- 7>&- 8>&- 9>&-
) &
new=$!
exec 4>&- 6<&-
if ! list_draining '' "$new"; then
	exec 7>&-
	fail "cannot list the new process (pid $new) in $draining"
fi
printf 'go\n' >&7
exec 7>&-

# 5. Readiness: a reader of fd 5 (0 ready, 1 EOF, 2 another line, which
# it keeps), polled until the timeout has passed on the clock (in tenths
# of a second where `sleep` takes them), then killed. The new process's
# end of file comes once it has closed fd 3 (it is the only writer). A
# helper killed before the reader runs leaves "ready" without a reader:
# the new process's report fails, and it logs that and serves on, listed.
(
	if IFS= read -r line <&5 && [ "$line" = ready ]; then
		exit 0
	fi
	[ -n "$line" ] || exit 1
	printf '%s\n' "$line" >"$dir/line"
	exit 2
) &
reader=$!
exec 5<&-
tick=0.1
sleep "$tick" 2>/dev/null || tick=1
t0=$(now)
while running "$reader"; do
	if past "$t0" "$timeout"; then
		kill "$reader" 2>/dev/null
		break
	fi
	sleep "$tick"
done
wait "$reader" 2>/dev/null
ready=$?
reader=
case $ready in
0) ;;
1) fail "the new process exited before it was ready (see $logfile)" ;;
2) fail "the new process reported '$(tr -d '\000-\037\177' <"$dir/line" | cut -c1-80)' instead of ready" ;;
*) fail "the new process was not ready within $timeout s (see $logfile)" ;;
esac
[ "$(exe_of "$new")" = "$real" ] || fail "the new process (pid $new) is not running $real"

# 6. The handover, not to be interrupted halfway. The old process is on
# the draining list before the pid file names the new one.
trap '' HUP INT TERM
list_draining '' "$old" || fail "cannot write $draining (pid $old not handed over)"
if ! write_pidfile "$new"; then
	list_draining "$old" ''
	fail "cannot write $pidfile"
fi
handed_over=yes
list_draining "$new" ''
sleep "$grace"
if ! running "$new" || [ "$(exe_of "$new")" != "$real" ]; then
	wait "$new" 2>/dev/null
	[ "$(exe_of "$old")" = "$real" ] ||
		fail "the new process (pid $new) and the old one (pid $old) both ended during the grace: nothing serves (see $logfile)"
	write_pidfile "$old" || fail "the new process (pid $new) ended during the grace, and $pidfile cannot be pointed back at pid $old, which serves on"
	list_draining "$old" ''
	fail "the new process (pid $new) ended during the grace; pid $old serves on and $pidfile names it again (see $logfile)"
fi
[ "$(exe_of "$old")" = "$real" ] || exit 0
kill -HUP "$old" 2>/dev/null ||
	fail "cannot send SIGHUP to pid $old ($pidfile already names the new pid $new)"
running "$new" ||
	fail "the new process (pid $new) ended right after the SIGHUP to pid $old, which now drains: nothing takes new connections; start the server again (see $logfile)"

# 7. The lock goes once the old listeners are closed.
t0=$(now)
while running "$old"; do
	holds_listener "$old"
	case $? in
	1) break ;;
	2)
		running "$old" || break
		warn "cannot read /proc/$old/fd; not waiting for its listeners to close"
		break
		;;
	esac
	if past "$t0" "$close_timeout"; then
		warn "pid $old still listens after $close_timeout s; releasing the lock"
		break
	fi
	sleep "$tick"
done
exit 0
