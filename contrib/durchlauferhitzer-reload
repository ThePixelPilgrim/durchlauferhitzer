#!/bin/sh
# durchlauferhitzer-reload: restart a running server without losing a
# connection (FR-PROC-07, the HAProxy model). POSIX sh (dash, busybox ash).
#
# usage: durchlauferhitzer-reload <binary> <config> <pidfile> <logfile> [ready-timeout-seconds]
#
#  0. Take the lock <pidfile>.lock (a directory holding the helper's pid):
#     one reload at a time.
#  1. <binary> --check <config>; on an error, print it and stop.
#  2. net.ipv4.tcp_migrate_req must be 1 (written if 0, never restored):
#     the old process's queued connections then move to the new one.
#  3. The pid in <pidfile> must run <binary> (" (deleted)" allowed: the
#     binary may be replaced in place, not re-pointed by a symlink).
#  4. Start "<binary> --ready-fd 3 <config>" in its own session, output
#     appended to <logfile>, fd 3 a FIFO in a fresh private directory,
#     fds 4-9 closed.
#  5. Wait for "ready" (default 30 s). Otherwise stop the new process and
#     leave the old one untouched.
#  6. Signals ignored from here: point <pidfile> at the new process (temp
#     file, then rename), add the old pid and its start time to
#     <pidfile>.draining (the OpenRC script's stop ends those still
#     running), send it SIGHUP: it
#     closes its listeners and drains.
#
# Exit 0 on success; 1 with a one-line reason on stderr otherwise.

# shellcheck disable=SC2317 # cleanup and its helpers run from a trap

me=durchlauferhitzer-reload
migrate=/proc/sys/net/ipv4/tcp_migrate_req

fail() {
	printf '%s: %s\n' "$me" "$*" >&2
	exit 1
}

usage() {
	fail "usage: $me <binary> <config> <pidfile> <logfile> [ready-timeout-seconds]"
}

[ $# -eq 4 ] || [ $# -eq 5 ] || usage
binary=$1 config=$2 pidfile=$3 logfile=$4 timeout=${5:-30}
case $timeout in
'' | *[!0-9]* | 0*) usage ;;
esac

# The state of a pid ("R", "S", "Z", ...), empty if there is none.
state() {
	sed -n 's/^.*) \(.\).*$/\1/p' "/proc/$1/stat" 2>/dev/null
}

running() {
	s=$(state "$1")
	[ -n "$s" ] && [ "$s" != Z ]
}

# The start time of a pid (field 22 of its stat, counted after the last
# ")": the command name may hold spaces and parentheses).
start_time() {
	sed -n 's/^.*) //p' "/proc/$1/stat" 2>/dev/null | cut -d ' ' -f 20
}

# The executable a pid runs, without the " (deleted)" of a replaced file.
exe_of() {
	e=$(readlink "/proc/$1/exe" 2>/dev/null) || return 1
	printf '%s\n' "${e% (deleted)}"
}

lock=$pidfile.lock locked='' dir='' new='' reader='' handed_over=''

# Stops a new process that was not handed over: SIGTERM, then SIGKILL
# after 5 s; then reaps it.
stop_new() {
	kill -TERM "$new" 2>/dev/null
	n=0
	while running "$new" && [ "$n" -lt 5 ]; do
		sleep 1
		n=$((n + 1))
	done
	running "$new" && kill -KILL "$new" 2>/dev/null
	wait "$new" 2>/dev/null
}

cleanup() {
	[ -n "$reader" ] && kill "$reader" 2>/dev/null
	[ -n "$new" ] && [ -z "$handed_over" ] && stop_new
	[ -n "$dir" ] && rm -rf "$dir"
	[ -n "$locked" ] && rm -f "$lock/pid" && rmdir "$lock" 2>/dev/null
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

# 0. One reload at a time.
if ! err=$(mkdir "$lock" 2>&1); then
	if [ -d "$lock" ]; then
		holder=
		{ read -r holder <"$lock/pid"; } 2>/dev/null
		fail "another reload is running (pid ${holder:-unknown}; remove $lock if none is)"
	fi
	fail "cannot create the lock $lock: ${err#mkdir: }"
fi
locked=yes
echo $$ >"$lock/pid"

# 1. The config.
if ! out=$("$binary" --check "$config" 2>&1); then
	[ -n "$out" ] && printf '%s\n' "$out" >&2
	fail "the config check failed: $config"
fi

# 2. Queued connections must move to the new process.
[ -e "$migrate" ] || fail "$migrate is missing (Linux 5.14 or later is needed)"
if [ "$(cat "$migrate" 2>/dev/null)" != 1 ]; then
	{ echo 1 >"$migrate"; } 2>/dev/null
	[ "$(cat "$migrate" 2>/dev/null)" = 1 ] || fail "cannot set $migrate to 1"
fi

# 3. The old process.
real=$(readlink -f "$binary") || fail "no binary: $binary"
old=
{ read -r old <"$pidfile"; } 2>/dev/null
case $old in
'' | *[!0-9]*) fail "no pid in $pidfile" ;;
esac
[ "$(exe_of "$old")" = "$real" ] || fail "pid $old (from $pidfile) is not running $real"

# 4. The new process, with fd 3 the write end of the FIFO and none of
# this shell's other descriptors below 10 (POSIX can name no higher ones).
{ printf '' >>"$logfile"; } 2>/dev/null || fail "cannot append to $logfile"
dir=$(mktemp -d) || fail "mktemp -d failed"
fifo=$dir/ready
mkfifo -m 600 "$fifo" || fail "mkfifo failed"
setsid "$binary" --ready-fd 3 "$config" </dev/null >>"$logfile" 2>&1 3>"$fifo" \
	4>&- 5>&- 6>&- 7>&- 8>&- 9>&- &
new=$!

# 5. Readiness: a reader (0 ready, 1 EOF, 2 another line, which it keeps),
# polled until the timeout (in tenths of a second where `sleep` takes
# them), then killed.
(
	if IFS= read -r line <"$fifo" && [ "$line" = ready ]; then
		exit 0
	fi
	[ -n "$line" ] || exit 1
	printf '%s\n' "$line" >"$dir/line"
	exit 2
) &
reader=$!
tick=0.1 per=10
sleep "$tick" 2>/dev/null || tick=1 per=1
n=0
while running "$reader"; do
	if [ "$n" -ge $((timeout * per)) ]; then
		kill "$reader" 2>/dev/null
		break
	fi
	sleep "$tick"
	n=$((n + 1))
done
wait "$reader" 2>/dev/null
ready=$?
reader=
case $ready in
0) ;;
1) fail "the new process exited before it was ready (see $logfile)" ;;
2) fail "the new process reported '$(tr -d '\000-\037\177' <"$dir/line" | cut -c1-80)' instead of ready" ;;
*) fail "the new process was not ready within $timeout s (see $logfile)" ;;
esac
[ "$(exe_of "$new")" = "$real" ] || fail "the new process (pid $new) is not running $real"

# 6. The handover, not to be interrupted halfway.
trap '' HUP INT TERM
tmp=$(mktemp "$pidfile.XXXXXX") || fail "cannot write next to $pidfile"
if ! { printf '%s\n' "$new" >"$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$pidfile"; }; then
	rm -f "$tmp"
	fail "cannot write $pidfile"
fi
handed_over=yes
# The draining list ("<pid> <start time>" lines): the old process, after
# those listed that still run (same binary, same start time).
draining=$pidfile.draining
old_start=$(start_time "$old")
if tmp=$(mktemp "$draining.XXXXXX"); then
	if ! {
		if [ -f "$draining" ]; then
			while read -r pid start; do
				case $pid in
				'' | *[!0-9]* | "$old") continue ;;
				esac
				[ -n "$start" ] && [ "$(start_time "$pid")" = "$start" ] &&
					[ "$(exe_of "$pid")" = "$real" ] && printf '%s %s\n' "$pid" "$start"
			done <"$draining"
		fi
		printf '%s %s\n' "$old" "$old_start"
	} >"$tmp" || ! mv -f "$tmp" "$draining"; then
		rm -f "$tmp"
	fi
fi
if [ "$(exe_of "$old")" = "$real" ]; then
	kill -HUP "$old" 2>/dev/null ||
		fail "cannot send SIGHUP to pid $old ($pidfile already names the new pid $new)"
fi
exit 0
