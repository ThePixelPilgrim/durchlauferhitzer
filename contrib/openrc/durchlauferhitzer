#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034 # the variables are read by openrc-run
# durchlauferhitzer under OpenRC (FR-PROC-07), modelled on Alpine's haproxy
# script. Settings: /etc/conf.d/durchlauferhitzer. `reload` restarts
# without losing a connection (durchlauferhitzer-reload).

description="durchlauferhitzer HTTP server"
extra_commands="checkconfig"
extra_started_commands="reload"

command=${command:-/usr/sbin/durchlauferhitzer}
cfgfile=${cfgfile:-/etc/durchlauferhitzer/durchlauferhitzer.conf}
logfile=${logfile:-/var/log/durchlauferhitzer.log}
reload_helper=${reload_helper:-/usr/libexec/durchlauferhitzer/durchlauferhitzer-reload}
ready_timeout=${ready_timeout:-30}
reload_grace=${reload_grace:-1}

command_args="$cfgfile"
command_background=yes
pidfile="/run/$RC_SVCNAME.pid"
output_log="$logfile"
error_log="$logfile"
required_files="$cfgfile"
# SIGTERM drains for up to shutdown_timeout (default 30s).
retry=${retry:-TERM/35/KILL/5}

depend() {
	need net
	after firewall
	use logger
}

checkconfig() {
	ebegin "Checking $cfgfile"
	"$command" --check "$cfgfile" >/dev/null
	eend $?
}

start_pre() {
	checkconfig
}

# The processes a reload left (the helper lists them in
# $pidfile.draining as "<pid> <start time>"): those still running with
# that start time (field 22 of their stat) get the signals of $retry,
# like the server itself, then the list goes. Only the root-run helper
# writes the list, and a pid with its start time names one process (a
# reused pid has another start time): $command, draining or not handed
# over, or the helper's own fork on its way to it (setsid, then
# $command), which a killed helper may leave; so the executable is not
# checked.
#
# A process is tracked as "<pid>:<start time>" throughout: each signal
# and each poll checks the start time again, so a pid that ends and is
# reused while stop_post runs (between two polls) is never signalled.
stop_post() {
	dl_list="$pidfile.draining"
	[ -f "$dl_list" ] || return 0
	dl_procs=
	while read -r dl_pid dl_start; do
		case $dl_pid in
		'' | *[!0-9]*) continue ;;
		esac
		case $dl_start in
		'' | *[!0-9]*) continue ;;
		esac
		dl_runs "$dl_pid" "$dl_start" && dl_procs="$dl_procs $dl_pid:$dl_start"
	done <"$dl_list"
	if [ -z "$dl_procs" ]; then
		rm -f "$dl_list"
		return 0
	fi
	ebegin "Stopping draining $RC_SVCNAME processes:$(dl_pids_of "$dl_procs")"
	case $retry in
	*/*) dl_schedule=$retry ;;
	*) dl_schedule="TERM/${retry:-5}/KILL/5" ;;
	esac
	dl_ifs=$IFS
	IFS=/
	# shellcheck disable=SC2086 # split on /
	set -- $dl_schedule
	IFS=$dl_ifs
	while [ $# -ge 2 ] && [ -n "$dl_procs" ]; do
		for dl_proc in $dl_procs; do
			dl_runs "${dl_proc%%:*}" "${dl_proc#*:}" &&
				kill -s "${1#SIG}" "${dl_proc%%:*}" 2>/dev/null
		done
		dl_n=0
		while :; do
			dl_left=
			for dl_proc in $dl_procs; do
				dl_runs "${dl_proc%%:*}" "${dl_proc#*:}" && dl_left="$dl_left $dl_proc"
			done
			dl_procs=$dl_left
			[ -z "$dl_procs" ] || [ "$dl_n" -ge "$2" ] && break
			sleep 1
			dl_n=$((dl_n + 1))
		done
		shift 2
	done
	[ -z "$dl_procs" ] && rm -f "$dl_list"
	[ -z "$dl_procs" ]
	eend $? "still running:$(dl_pids_of "$dl_procs")"
}

# Whether pid $1 runs (not a zombie) with start time $2.
dl_runs() {
	dl_stat=$(sed -n 's/^.*) //p' "/proc/$1/stat" 2>/dev/null)
	case $dl_stat in
	'' | Z*) return 1 ;;
	esac
	[ "$(printf '%s\n' "$dl_stat" | cut -d ' ' -f 20)" = "$2" ]
}

# The pids of the "<pid>:<start time>" words in $1, each after a space.
dl_pids_of() {
	for dl_word in $1; do
		printf ' %s' "${dl_word%%:*}"
	done
}

reload() {
	ebegin "Reloading $RC_SVCNAME"
	"$reload_helper" "$command" "$cfgfile" "$pidfile" "$logfile" "$ready_timeout" "$reload_grace"
	eend $?
}
