#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034 # the variables are read by openrc-run
# durchlauferhitzer under OpenRC (FR-PROC-07), modelled on Alpine's haproxy
# script. Settings: /etc/conf.d/durchlauferhitzer. `reload` restarts
# without losing a connection (durchlauferhitzer-reload). Not supervised
# (FR-PROC-07a): supervise-daemon respawns after every exit and watches
# only its own child, so it cannot carry the reload's hand-over (README,
# "OpenRC: no restart after a crash"). `stop` and `status` never act on a
# pid file whose process positively runs another binary (a reused pid).

description="durchlauferhitzer HTTP server"
extra_commands="checkconfig"
extra_started_commands="reload"

command=${command:-/usr/sbin/durchlauferhitzer}
cfgfile=${cfgfile:-/etc/durchlauferhitzer/durchlauferhitzer.conf}
logfile=${logfile:-/var/log/durchlauferhitzer.log}
reload_helper=${reload_helper:-/usr/libexec/durchlauferhitzer/durchlauferhitzer-reload}
ready_timeout=${ready_timeout:-30}
reload_grace=${reload_grace:-1}

command_args="$cfgfile"
command_background=yes
pidfile="/run/$RC_SVCNAME.pid"
output_log="$logfile"
error_log="$logfile"
required_files="$cfgfile"
# SIGTERM drains for up to shutdown_timeout (default 30s).
retry=${retry:-TERM/35/KILL/5}

depend() {
	need net
	after firewall
	use logger
}

checkconfig() {
	ebegin "Checking $cfgfile"
	"$command" --check "$cfgfile" >/dev/null
	eend $?
}

start_pre() {
	checkconfig
}

# Records the server's executable (the real path of $command) for the
# pid-file guard below: a later edit of `command`, or a symlink switched to
# another binary, then does not make the running server a stranger.
start_post() {
	dl_record_exe
}

dl_record_exe() {
	dl_rec=$(readlink -f "$command" 2>/dev/null)
	[ -z "$dl_rec" ] || service_set_value server_exe "$dl_rec"
}

# The pid-file guard (FR-PROC-07a). OpenRC checks only that the pid file's
# pid exists: after a crash whose pid is reused, its `status` reports
# started and its `stop` signals the new holder. dl_main_identify sorts
# the pid file's process into one of three, in $dl_who (its pid in
# $dl_main):
#  - server: its executable was read and is one of the server's;
#  - stranger: its executable was read and is none of them;
#  - unknown: anything else (no pid, not running, a zombie, the executable
#    unreadable, the process changing during the check).
# Only a stranger is handled here; server and unknown go to OpenRC's own
# functions, so the guard never does worse than stock OpenRC. Reading
# another user's /proc/<pid>/exe needs root with CAP_SYS_PTRACE: without
# it (a non-root `status`, a container that drops the capability) the
# server's process reads as unknown, and there is no reuse protection.
#
# The server's executables are the paths of the server_exe recorded at
# start and after each reload, of the command OpenRC recorded at start,
# and of the current $command (a reload runs that one). A path matches
# with " (deleted)" stripped: a binary replaced in place is still the
# server, as for the reload helper's step 3. The pid file holds a pid
# only, so the draining list's pid-plus-start-time check (stop_post)
# cannot apply; the start time is read before and after the executable,
# so a pid reused during the check reads as unknown.
dl_main_identify() {
	dl_main='' dl_who=unknown
	{ read -r dl_main <"$pidfile"; } 2>/dev/null
	case $dl_main in
	'' | *[!0-9]*) return 0 ;;
	esac
	dl_before=$(dl_start_of "$dl_main")
	[ -n "$dl_before" ] || return 0
	dl_exe=$(readlink "/proc/$dl_main/exe" 2>/dev/null) || return 0
	[ -n "$dl_exe" ] || return 0
	[ "$(dl_start_of "$dl_main")" = "$dl_before" ] || return 0
	dl_exe=${dl_exe% (deleted)}
	dl_known=''
	for dl_name in "$(service_get_value server_exe 2>/dev/null)" \
		"$(dl_real "$(service_get_value command 2>/dev/null)")" \
		"$(dl_real "$command")"; do
		[ -n "$dl_name" ] || continue
		dl_known=yes
		if [ "$dl_exe" = "$dl_name" ]; then
			dl_who=server
			return 0
		fi
	done
	[ -z "$dl_known" ] || dl_who=stranger
	return 0
}

# The real path of $1, empty if $1 is empty or cannot be resolved.
dl_real() {
	[ -z "$1" ] || readlink -f "$1" 2>/dev/null
}

# The start time of pid $1 (field 22 of its stat), empty if it does not
# run or is a zombie.
dl_start_of() {
	dl_stat=$(sed -n 's/^.*) //p' "/proc/$1/stat" 2>/dev/null)
	case $dl_stat in
	'' | Z*) return 0 ;;
	esac
	printf '%s\n' "$dl_stat" | cut -d ' ' -f 20
}

# A stranger in the pid file (the crashed server's pid reused): nothing is
# signalled and the pid file goes, so a following start is not refused as
# "already running". Otherwise OpenRC's own stop.
stop() {
	dl_main_identify
	if [ "$dl_who" = stranger ]; then
		ewarn "$pidfile names pid $dl_main, which runs $dl_exe, not $RC_SVCNAME's binary (the server ended and its pid was reused): not signalled"
		rm -f "$pidfile"
		return 0
	fi
	default_stop
}

# A started service whose pid file names a stranger has crashed: OpenRC's
# crashed result (status 32), as for a pid that no longer runs. Otherwise
# OpenRC's own status.
status() {
	if service_started; then
		dl_main_identify
		if [ "$dl_who" = stranger ]; then
			eerror "status: crashed (pid $dl_main from $pidfile runs $dl_exe, not $RC_SVCNAME's binary)"
			return 32
		fi
	fi
	default_status
}

# The processes a reload left (the helper lists them in
# $pidfile.draining as "<pid> <start time>"): those still running with
# that start time (field 22 of their stat) get the signals of $retry,
# like the server itself, then the list goes. Only the root-run helper
# writes the list, and a pid with its start time names one process (a
# reused pid has another start time): $command, draining or not handed
# over, or the helper's own fork on its way to it (setsid, then
# $command), which a killed helper may leave; so the executable is not
# checked.
#
# A process is tracked as "<pid>:<start time>" throughout: each signal
# and each poll checks the start time again, so a pid that ends and is
# reused while stop_post runs (between two polls) is never signalled.
stop_post() {
	dl_list="$pidfile.draining"
	[ -f "$dl_list" ] || return 0
	dl_procs=
	while read -r dl_pid dl_start; do
		case $dl_pid in
		'' | *[!0-9]*) continue ;;
		esac
		case $dl_start in
		'' | *[!0-9]*) continue ;;
		esac
		dl_runs "$dl_pid" "$dl_start" && dl_procs="$dl_procs $dl_pid:$dl_start"
	done <"$dl_list"
	if [ -z "$dl_procs" ]; then
		rm -f "$dl_list"
		return 0
	fi
	ebegin "Stopping draining $RC_SVCNAME processes:$(dl_pids_of "$dl_procs")"
	case $retry in
	*/*) dl_schedule=$retry ;;
	*) dl_schedule="TERM/${retry:-5}/KILL/5" ;;
	esac
	dl_ifs=$IFS
	IFS=/
	# shellcheck disable=SC2086 # split on /
	set -- $dl_schedule
	IFS=$dl_ifs
	while [ $# -ge 2 ] && [ -n "$dl_procs" ]; do
		for dl_proc in $dl_procs; do
			dl_runs "${dl_proc%%:*}" "${dl_proc#*:}" &&
				kill -s "${1#SIG}" "${dl_proc%%:*}" 2>/dev/null
		done
		dl_n=0
		while :; do
			dl_left=
			for dl_proc in $dl_procs; do
				dl_runs "${dl_proc%%:*}" "${dl_proc#*:}" && dl_left="$dl_left $dl_proc"
			done
			dl_procs=$dl_left
			[ -z "$dl_procs" ] || [ "$dl_n" -ge "$2" ] && break
			sleep 1
			dl_n=$((dl_n + 1))
		done
		shift 2
	done
	[ -z "$dl_procs" ] && rm -f "$dl_list"
	[ -z "$dl_procs" ]
	eend $? "still running:$(dl_pids_of "$dl_procs")"
}

# Whether pid $1 runs (not a zombie) with start time $2.
dl_runs() {
	dl_now=$(dl_start_of "$1")
	[ -n "$dl_now" ] && [ "$dl_now" = "$2" ]
}

# The pids of the "<pid>:<start time>" words in $1, each after a space.
dl_pids_of() {
	for dl_word in $1; do
		printf ' %s' "${dl_word%%:*}"
	done
}

reload() {
	ebegin "Reloading $RC_SVCNAME"
	"$reload_helper" "$command" "$cfgfile" "$pidfile" "$logfile" "$ready_timeout" "$reload_grace"
	dl_status=$?
	# The new server runs the current $command (the helper checked it).
	[ "$dl_status" -ne 0 ] || dl_record_exe
	eend "$dl_status"
}
